# Fake values for tests. Both URLs may be overridden from the environment (CI does).
NODE_ENV=test
# What the app under test connects as: the restricted API user (created by the test setup).
DATABASE_URL=postgres://cookbook_api:cookbook_api@localhost:5432/cookbook_test
# Owner user: resets the schema and writes test fixtures.
MIGRATION_DATABASE_URL=postgres://cookbook:cookbook@localhost:5432/cookbook_test
# S3 contract test (apps/api/test/s3.test.ts): the SeaweedFS from docker-compose (CI starts its own).
S3_TEST_ENDPOINT=http://localhost:8333
