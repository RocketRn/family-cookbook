# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Two users (docs/DECISIONS.md D-013):
# - DATABASE_URL: what the API logs in as. A restricted user that owns nothing and can only act
#   through the roles cookbook_app / cookbook_system. `pnpm db:migrate` creates it from this URL.
# - MIGRATION_DATABASE_URL: the owner user, used only by db:migrate / db:seed / db:reset.
# The passwords below are fake local-development values.
DATABASE_URL=postgres://cookbook_api:cookbook_api@localhost:5432/cookbook
MIGRATION_DATABASE_URL=postgres://cookbook:cookbook@localhost:5432/cookbook

# Real bot token (production only). In development any non-empty placeholder works.
BOT_TOKEN=000000:placeholder-not-a-real-token
# Placeholders until the bot and Mini App are created in BotFather (PRD 7.3 #7).
BOT_USERNAME=your_cookbook_bot
MINI_APP_SHORT_NAME=cookbook

# Max age of initData auth_date, in seconds (PRD 4.3: 24 h).
INIT_DATA_MAX_AGE_SECONDS=86400

# Dev-only: accept initData signed with the FAKE dev token below, so the web app
# works in a plain browser. The API refuses to boot with this flag unless NODE_ENV=development.
ALLOW_DEV_INIT_DATA=true
DEV_BOT_TOKEN=000000:DEV-ONLY-FAKE-TOKEN

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Photo storage: any S3-compatible service, reached only through the S3 API (docs/DECISIONS.md).
# Locally this is SeaweedFS from docker-compose; the keys are fake, local-only values that match
# docker/seaweedfs/s3.json (the API refuses them when NODE_ENV=production).
S3_ENDPOINT=http://localhost:8333
# Address the browser uses to open photo links. Leave unset when it is the same as S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://media.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=cookbook-dev
S3_SECRET_KEY=cookbook-dev-secret
S3_BUCKET=cookbook-media
# Path-style URLs (http://host/bucket/key) - needed by SeaweedFS and most self-hosted S3 servers.
S3_FORCE_PATH_STYLE=true

# Request limits per minute (PRD 7.1). Over the limit the API answers 429 RATE_LIMITED.
RATE_LIMIT_PER_USER=60
RATE_LIMIT_PER_IP=300
RATE_LIMIT_UPLOADS_PER_USER=10
RATE_LIMIT_AUTH_FAILURES_PER_IP=20
# Set to true only behind a reverse proxy you control (so limits see the real client address).
TRUST_PROXY=false

# Worker: how often orphaned photo uploads (never attached to a recipe, older than 24 h) are removed.
MEDIA_CLEANUP_INTERVAL_MIN=60

# CSP report limit per IP per minute (POST /csp-report, docs/CSP.md).
RATE_LIMIT_CSP_REPORTS_PER_IP=60

# Import from text (POST /recipes/import): per-user limit per minute, the hard time limit for
# reading one text, and how many background parser threads run at once.
RATE_LIMIT_IMPORTS_PER_USER=10
IMPORT_TIMEOUT_MS=3000
IMPORT_WORKERS=2

# Web production build only (docs/CSP.md): addresses for the Content-Security-Policy.
# CSP_S3_ORIGIN=https://media.example.com
# CSP_API_ORIGIN=https://api.example.com
