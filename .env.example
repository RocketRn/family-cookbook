# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Two users (docs/DECISIONS.md D-013):
# - DATABASE_URL: what the API logs in as. A restricted user that owns nothing and can only act
#   through the roles cookbook_app / cookbook_system. `pnpm db:migrate` creates it from this URL.
# - MIGRATION_DATABASE_URL: the owner user, used only by db:migrate / db:seed / db:reset.
# The passwords below are fake local-development values.
DATABASE_URL=postgres://cookbook_api:cookbook_api@localhost:5432/cookbook
MIGRATION_DATABASE_URL=postgres://cookbook:cookbook@localhost:5432/cookbook

# Real bot token (production only). In development any non-empty placeholder works.
BOT_TOKEN=000000:placeholder-not-a-real-token
# Placeholders until the bot and Mini App are created in BotFather (PRD 7.3 #7).
BOT_USERNAME=your_cookbook_bot
MINI_APP_SHORT_NAME=cookbook

# Max age of initData auth_date, in seconds (PRD 4.3: 24 h).
INIT_DATA_MAX_AGE_SECONDS=86400

# Dev-only: accept initData signed with the FAKE dev token below, so the web app
# works in a plain browser. The API refuses to boot with this flag unless NODE_ENV=development.
ALLOW_DEV_INIT_DATA=true
DEV_BOT_TOKEN=000000:DEV-ONLY-FAKE-TOKEN

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Local S3-compatible storage (SeaweedFS in docker-compose) - unused in Sprint 1, wired for BE-05.
# Fake local-only credentials, matching docker/seaweedfs/s3.json.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=cookbook-dev
S3_SECRET_KEY=cookbook-dev-secret
S3_BUCKET=cookbook-media
