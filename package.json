{
  "name": "family-cookbook",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cookbook/api --filter @cookbook/web --filter @cookbook/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @cookbook/api db:migrate",
    "db:seed": "pnpm --filter @cookbook/api db:seed",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm build && pnpm check:bundle && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
