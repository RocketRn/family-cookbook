{
  "name": "@cookbook/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:s3": "vitest run --config vitest.s3.config.ts",
    "db:migrate": "tsx --conditions=source src/db/cli.ts migrate",
    "db:rollback": "tsx --conditions=source src/db/cli.ts rollback",
    "db:reset": "tsx --conditions=source src/db/cli.ts reset",
    "db:seed": "tsx --conditions=source src/db/cli.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "@cookbook/recipe-core": "workspace:*",
    "sharp": "0.35.4",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0"
  },
  "devDependencies": {
    "@cookbook/fakebot": "workspace:*",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "exports": {
    "./jobs": {
      "source": "./src/jobs.ts",
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    }
  }
}
