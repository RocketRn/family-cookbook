# Production settings (docs/DEPLOY-GCP.ru.md). Copy to .env ON THE SERVER and fill in there:
#   cp .env.example .env && nano .env
# Never paste these values into a chat, a GitHub page, an e-mail or a screenshot. The app refuses
# to start while any value below is still a placeholder.

# The address of the app, e.g. family-cookbook.duckdns.org (without https://).
DOMAIN=CHANGE_ME.duckdns.org

# Database passwords: two different random values. Make each with:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
API_DB_PASSWORD=CHANGE_ME

# From @BotFather: the token, the bot's username (without @) and the Mini App's short name.
BOT_TOKEN=CHANGE_ME
BOT_USERNAME=your_cookbook_bot
MINI_APP_SHORT_NAME=cookbook

# Photos: the Cloud Storage bucket and the HMAC key of its service account.
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Nightly database backups (backup.sh): the backup bucket. No key: the VM's own account is used.
BACKUP_BUCKET=CHANGE_ME

# DuckDNS: keeps DOMAIN pointing at this VM (duckdns.sh). The subdomain without .duckdns.org.
DUCKDNS_SUBDOMAIN=CHANGE_ME
DUCKDNS_TOKEN=CHANGE_ME
